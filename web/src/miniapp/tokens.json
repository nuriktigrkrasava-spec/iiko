{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "WIRE GROUP Telegram Mini App — ночная тема из референса night-quarter-reference.png. Семплы честные (PIL), пары проверены contrast.py (AA+). Хроматика только у денег: красный — потеря, зелёный — возврат, янтарь — жизнь/свет.",

  "primitive": {
    "night": {
      "void": { "$type": "color", "$value": "#000000", "$description": "пустота вокруг сцены" },
      "950": { "$type": "color", "$value": "#0B0A0E", "$description": "фон сцены, семпл #080810" },
      "900": { "$type": "color", "$value": "#16120F", "$description": "приподнятая поверхность, семпл #181010" },
      "850": { "$type": "color", "$value": "#211B17", "$description": "карточка/шторка, семпл #201818" },
      "800": { "$type": "color", "$value": "#322A24", "$description": "волосяная линия" }
    },
    "amber": {
      "200": { "$type": "color", "$value": "#F7D9A4" },
      "300": { "$type": "color", "$value": "#F1BA68", "$description": "пик оконного света" },
      "500": { "$type": "color", "$value": "#B88D53", "$description": "фонарь" },
      "700": { "$type": "color", "$value": "#5A381B" },
      "900": { "$type": "color", "$value": "#3D2717", "$description": "тёплая глубина комнаты" }
    },
    "red": {
      "300": { "$type": "color", "$value": "#F0563A", "$description": "текст потери, AA на фоне и карточке" },
      "600": { "$type": "color", "$value": "#8A2A12", "$description": "средний тон здания" },
      "900": { "$type": "color", "$value": "#561708", "$description": "свечение/заливка" }
    },
    "green": {
      "300": { "$type": "color", "$value": "#8FBF6F", "$description": "текст возврата" },
      "700": { "$type": "color", "$value": "#415119", "$description": "листва (семпл)" },
      "900": { "$type": "color", "$value": "#1F2B14", "$description": "свечение возврата" }
    },
    "ink": {
      "100": { "$type": "color", "$value": "#F0EAE0", "$description": "тёплый почти-белый" },
      "400": { "$type": "color", "$value": "#A89E90" },
      "600": { "$type": "color", "$value": "#6E655B", "$description": "только не-текст" }
    }
  },

  "semantic": {
    "surface": {
      "void": { "$type": "color", "$value": "{primitive.night.void}" },
      "base": { "$type": "color", "$value": "{primitive.night.950}" },
      "raised": { "$type": "color", "$value": "{primitive.night.900}" },
      "sheet": { "$type": "color", "$value": "{primitive.night.850}" }
    },
    "border": {
      "hairline": { "$type": "color", "$value": "{primitive.night.800}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{primitive.ink.100}" },
      "secondary": { "$type": "color", "$value": "{primitive.ink.400}" },
      "nontext": { "$type": "color", "$value": "{primitive.ink.600}", "$description": "пустые сегменты, декор — не для чтения" }
    },
    "money": {
      "loss": { "$type": "color", "$value": "{primitive.red.300}" },
      "loss-wash": { "$type": "color", "$value": "{primitive.red.900}" },
      "gain": { "$type": "color", "$value": "{primitive.green.300}" }
    },
    "life": {
      "accent": { "$type": "color", "$value": "{primitive.amber.300}", "$description": "свет окон: фокус, «жизнь» сцены" },
      "dim": { "$type": "color", "$value": "{primitive.amber.500}" },
      "wash": { "$type": "color", "$value": "{primitive.amber.900}" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "12px" },
      "card": { "$type": "dimension", "$value": "16px" },
      "sheet": { "$type": "dimension", "$value": "20px", "$description": "верх шторки" }
    },
    "space": {
      "unit": { "$type": "dimension", "$value": "4px" },
      "touch": { "$type": "dimension", "$value": "48px", "$description": "минимальная цель — всё одним пальцем" }
    },
    "font": {
      "ui": { "$type": "fontFamily", "$value": ["Onest", "Golos Text", "ui-sans-serif", "system-ui", "sans-serif"] },
      "money": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "деньги всегда tabular-nums" }
    }
  },

  "component": {
    "story": {
      "number-size": { "$type": "dimension", "$value": "clamp(56px, 18vw, 88px)", "$description": "витринное число кадра — событие, не строка данных" },
      "number-size-compact": { "$type": "dimension", "$value": "clamp(34px, 11vw, 46px)" },
      "sentence-size": { "$type": "dimension", "$value": "18px" },
      "sub-size": { "$type": "dimension", "$value": "14px" },
      "glow": { "$type": "shadow", "$value": "radial-gradient снизу кадра в тоне события (loss/gain/life)", "$description": "единственный эффект сцены — свет изнутри, как окна референса" }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "enter": { "$type": "duration", "$value": "260ms" },
      "ease-out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
    },
    "case-card": {
      "bg": { "$type": "color", "$value": "{semantic.surface.sheet}" },
      "amount": { "$type": "color", "$value": "{semantic.money.loss}" }
    }
  }
}
