# Скопируй в .env и заполни значения.
# В production эти переменные задаются через Render Dashboard → Environment.

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Разбор фото чек-листов моделью. ВКЛЮЧЁН по умолчанию с 26.08.2026.
# Выключить срочно: CHECKLIST_AI=0 (без деплоя, перезапуск сервиса).
# Тратит деньги: держится выборка CHECKLIST_SAMPLE_PCT (по умолчанию 20%)
# плюс спорные случаи. Требует ANTHROPIC_API_KEY.
CHECKLIST_AI=
# Хранить ли сами кадры на диске. По умолчанию НЕТ: их не отдаёт наружу ни
# одна ручка, разбор берёт кадры из памяти запроса, а на /data они копили
# гигабайты бессрочно. Включать, только если появится просмотр фото.
CHECKLIST_KEEP_PHOTOS=
# С какого дня чек-листы идут в зачёт на «Горе» (YYYY-MM-DD).
# Пусто — не идут вовсе: ни баллов, ни штрафов. Это режим тестирования.
# Ожидание считается от этой даты для ВСЕХ филиалов одинаково, сдавал
# филиал хоть раз или нет. Ставить в день реальной раскатки, не задним числом.
CHECKLIST_FROM=

# Логин для демо-режима (любой ID, под которым показываем фейковые данные)
DEMO_API_LOGIN=demo

# Путь к SQLite БД. На Render укажи /data/iiko_boss.db (persistent disk mount)
DB_PATH=iiko_boss.db

# Ключ шифрования паролей iiko в БД (Fernet, 32-байтный base64)
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: при потере ключа невозможно расшифровать сохранённые пароли
ENCRYPTION_KEY=

# production — отключает Swagger /docs, включает HSTS, ограничивает CORS
ENVIRONMENT=production

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token
# Случайная строка. Передай тот же secret_token при setWebhook
# ОБЯЗАТЕЛЕН в production вместе с TELEGRAM_BOT_TOKEN и ENCRYPTION_KEY.
# Сначала задайте все три значения, только потом перезапускайте сервис.
TELEGRAM_WEBHOOK_SECRET=

# Сети/адреса ТОЛЬКО ваших reverse proxy (через запятую, IPv4/IPv6 CIDR).
# Уточните реальный socket peer и цепочку прокси у хостинга/в конфигурации nginx.
# Не используйте 0.0.0.0/0, ::/0 или произвольный адрес посетителя.
# Пусто = X-Forwarded-For не доверяем; за прокси это общий лимит на всех.
TRUSTED_PROXY_CIDRS=

# Дополнительные доверенные хосты iiko и CSV (без схемы, пути и wildcard).
# *.iiko.it и Google Sheets уже разрешены. Всегда HTTPS:443 и действующий TLS.
# Самоподписанный сертификат надо заменить; verify=False не использовать.
IIKO_TRUSTED_HOSTS=
CSV_TRUSTED_HOSTS=

# Ваши разрешённые ключи 2ГИС. Без них проверьте доступность вкладки отзывов.
REVIEWS_2GIS_KEY=
CATALOG_2GIS_KEY=

# Отдельный ключ ссылок необязателен: пусто = используется ENCRYPTION_KEY.
# Не менять произвольно: это отзовёт существующие ссылки /m, /w и приглашения.
WIDGET_SECRET=
# Точечный отзыв виджетов и /j журналов выбранного владельца, без /m и invite.
# JSON uid -> монотонная версия; пример (не реальный uid): {"123":1}.
# Увеличить версию, перезапустить и перевыпустить ссылки. Не удалять/уменьшать
# запись: это снова сделает старые ссылки действительными. См. deployment-review.
WIDGET_OWNER_VERSIONS={}

# Готовый JSON-разбор только для одного указанного владельца (не снимки БД).
# По умолчанию выключен. Снимки сравнения в БД изолированы по владельцу.
ASSISTANT_SNAPSHOT=
ASSISTANT_SNAPSHOT_OWNER_ID=

# Вход/приглашения сотрудников включать только после проверки Telegram-flow.
NATIVE_STAFF_ENABLED=0
NATIVE_JOIN_ENABLED=0
# HTTPS origin приложения без пути. Fallback: RENDER_EXTERNAL_URL, MINIAPP_URL.
NATIVE_APP_ORIGIN=

# Push выключен до настройки сервисного аккаунта Firebase на сервере.
PUSH_ENABLED=0
FIREBASE_PROJECT_ID=findirector
FIREBASE_SERVICE_ACCOUNT_FILE=

# Фудкост в наблюдениях «Что изменилось». ВЫКЛЮЧЕН: у самохостед-iikoWeb он
# считается из техкарт x цен по всему меню — самый тяжёлый показатель сбора, а
# в оценку филиала на «Горе» не входит вовсе. Вернуть: ASSISTANT_FOODCOST=1
ASSISTANT_FOODCOST=
# Потолок одновременных запросов к iiko при сборе показателей (по умолчанию 12)
ASSISTANT_MAX_CALLS=
